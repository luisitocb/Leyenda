{
  "name": "@leyenda/balance-sim",
  "version": "0.1.0",
  "private": true,
  "description": "CLI de simulación masiva de temporadas para validar el balanceo del motor de partidos",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@leyenda/engine": "workspace:*",
    "@leyenda/shared": "workspace:*",
    "@leyenda/worldgen": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^1.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
